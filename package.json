{
  "name": "tablm",
  "version": "0.1.0",
  "description": "Expose web AI chats (ChatGPT, Kimi, ...) as MCP tools for Claude via Chrome DevTools Protocol",
  "type": "module",
  "bin": {
    "tablm": "dist/index.js",
    "tablm-gateway": "dist/gateway.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "gateway": "node dist/gateway.js",
    "test": "npm run build --silent && node tests/parse.test.mjs && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/ws": "^8.18.1",
    "chrome-remote-interface": "^0.33.2",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.31.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
